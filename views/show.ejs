<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>Post in Detail</title>

    <link rel="stylesheet" href="/style.css">

</head>


<body>

    <header class="header">

        <div class="logo">
            Quora
        </div>

        <a href="/posts" class="header-btn">
            All Posts
        </a>

    </header>


    <div class="container">

        <h1 class="page-title">
            Here is your post in detail
        </h1>


        <p class="post-id">

            <strong>Post ID:</strong>

            <%= post.id %>

        </p>


        <div class="post">

            <h3 class="user">
                @<%= post.username %>
            </h3>

            <h4 class="content">
                <%= post.content %>
            </h4>


            <div class="actions">

                <!-- EDIT -->

                <a
                    href="/posts/<%= post.id %>/edit"
                    class="edit-btn"
                >
                    Edit Post
                </a>


                <!-- DELETE -->

                <form
                    action="/posts/<%= post.id %>?_method=DELETE"
                    method="POST"
                    class="delete-form"
                >

                    <button
                        type="submit"
                        class="delete-btn"
                    >
                        Delete Post
                    </button>

                </form>

            </div>

        </div>


        <a href="/posts" class="back-btn">
            ← Back to All Posts
        </a>

    </div>

</body>

</html>